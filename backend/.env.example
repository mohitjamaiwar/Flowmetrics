# Server
PORT=5000

# MongoDB Atlas connection string
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/flowmetrics?retryWrites=true&w=majority
MONGODB_URI=

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS - the deployed (or local) frontend origin
FRONTEND_URL=http://localhost:3000
